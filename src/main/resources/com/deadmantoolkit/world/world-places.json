{
  "version": 1,
  "revision": 1791388979,
  "about": "Places a Deadman world event broadcast can name. x/y are world tiles (plane 0 unless given); radius is how far a place spreads in tiles (default 8). Places on another map (Zanaris, the Mole Hole) give their surface entrance. Regions are kingdoms and areas a broadcast names instead of a spot. Names and aliases match ignoring case, apostrophes and punctuation, and must be unique. revision is the unix time of the last change (the newest copy wins: the plugin's bundled copy, its saved copy or the server's). wording: words dropped from the front (leads) or end (tails) of a place before matching.",
  "wording": {
    "leads": ["throughout", "within", "surrounding", "on top of", "the top of", "top of", "the mounds at", "the mounds of", "mounds at", "the mounds", "around", "near", "nearby", "just outside", "outside", "inside", "somewhere in", "deep in", "the outskirts of", "outskirts of", "the area around", "the area near", "the area of", "the area", "area of", "the ruins at", "in", "at", "on", "by", "the"],
    "tails": ["kingdom", "region", "area", "lands", "province"]
  },
